<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="膳食偏好设置"
            android:textColor="@color/onBackground"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Diet Type -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:backgroundTint="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="饮食类型"
                    android:textColor="@color/onBackground"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rg_diet_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rb_normal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="普通饮食"
                        android:textColor="@color/onBackground" />

                    <RadioButton
                        android:id="@+id/rb_vegan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="纯素 (Vegan)"
                        android:textColor="@color/onBackground" />

                    <RadioButton
                        android:id="@+id/rb_vegetarian"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="蛋奶素 (Vegetarian)"
                        android:textColor="@color/onBackground" />

                    <RadioButton
                        android:id="@+id/rb_low_cal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="低卡减脂"
                        android:textColor="@color/onBackground" />

                    <RadioButton
                        android:id="@+id/rb_high_protein"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="高蛋白增肌"
                        android:textColor="@color/onBackground" />

                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Excluded Ingredients -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:backgroundTint="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="忌口食材（逗号分隔）"
                    android:textColor="@color/onBackground"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <AutoCompleteTextView
                    android:id="@+id/actv_excluded"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="12dp"
                    android:background="@drawable/edit_bg"
                    android:hint="如: 花生, 海鲜, 辣椒"
                    android:textSize="14sp"
                    android:completionThreshold="1"
                    android:dropDownHeight="150dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Max Calories -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:backgroundTint="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="每餐最大热量 (kcal)"
                    android:textColor="@color/onBackground"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_max_calories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="12dp"
                    android:background="@drawable/edit_bg"
                    android:inputType="number"
                    android:hint="如: 800"
                    android:textSize="14sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Allergy Info -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:backgroundTint="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="过敏信息"
                    android:textColor="@color/onBackground"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_allergy_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="12dp"
                    android:background="@drawable/edit_bg"
                    android:hint="如: 花生过敏, 乳糖不耐受"
                    android:textSize="14sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Save button -->
        <Button
            android:id="@+id/btn_save_preferences"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="保存偏好设置"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:backgroundTint="@color/primary" />

    </LinearLayout>
</ScrollView>
